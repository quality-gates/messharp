<?xml version="1.0"?>
<ruleset name="Level1" xmlns="http://pmd.sf.net/ruleset/1.0.0">
  <description>Report every method's CCN and NPath</description>
  <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
    <properties><property name="reportLevel" value="1" /></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/NPathComplexity">
    <properties><property name="minimum" value="1" /></properties>
  </rule>
</ruleset>
