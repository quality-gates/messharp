                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "UnusedFormalParameter",
          "level": "warning",
          "message": {
            "text": "Avoid unused parameters such as 'y'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/exploratory-testing/2026-09-26-unusedcode-and-design-edgecases/fixtures/ReproOutTuple.cs"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
