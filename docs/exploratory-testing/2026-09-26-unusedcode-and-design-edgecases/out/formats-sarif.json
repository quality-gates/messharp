  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "messharp",
          "version": "0.0.0-dev",
          "rules": [
            {
              "id": "UnusedFormalParameter",
              "name": "UnusedFormalParameter",
              "helpUri": "https://phpmd.org/rules/unusedcode.html#unusedformalparameter",
              "shortDescription": {
                "text": "Avoid passing parameters to methods or constructors and then not using those parameters."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "UnusedFormalParameter",
          "level": "warning",
          "message": {
            "text": "Avoid unused parameters such as 'x'."
          },
